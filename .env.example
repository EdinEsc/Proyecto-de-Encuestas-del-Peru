# =========================
# MODO LOCAL CON POSTGRES DOCKER
# =========================
POSTGRES_DB=voting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/voting?sslmode=disable

# =========================
# BACKEND
# =========================
BACKEND_PORT=8080
JWT_SECRET=cambia-este-secreto-largo-y-seguro
FRONTEND_ORIGIN=http://localhost:3000
RECAPTCHA_SECRET=

# Admin inicial creado automáticamente por el contenedor backend
ADMIN_EMAIL=admin@votaciones.local
ADMIN_PASSWORD=admin123456

# Crea datos demo: regiones, elecciones y candidatos
SEED_DEMO_DATA=true

# =========================
# FRONTEND
# =========================
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
INTERNAL_API_URL=http://backend:8080

# =========================
# MODO NEON
# Para usar Neon, cambia DATABASE_URL por tu URL de Neon con sslmode=require
# y ejecuta: docker compose -f docker-compose.neon.yml up --build
# DATABASE_URL=postgresql://usuario:password@host.neon.tech/db?sslmode=require
